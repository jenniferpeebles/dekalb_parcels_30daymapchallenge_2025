# Secrets and local R state
.Renviron
.Rprofile
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Downloaded or generated data
data_raw/*
!data_raw/.gitkeep
data_clean/*
!data_clean/.gitkeep
outputs/*
!outputs/.gitkeep
exports/*
!exports/.gitkeep
logs/*
!logs/.gitkeep

# Rendered documents and caches
scripts/*_files/
scripts/*_cache/
*.html
*.pdf

# OS/editor clutter
.DS_Store
Thumbs.db
.vscode/

# Portable local developer tools
.tools/
